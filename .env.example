# Copiá este archivo a .env y completá los valores.
# .env está en .gitignore: nunca se commitea.

JIRA_SITE=https://axb-ing.atlassian.net
JIRA_EMAIL=tu-cuenta@ejemplo.com
JIRA_TOKEN=                  # https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_PROJECT=ING             # opcional
PORT=4321                    # opcional, sólo local

# Contraseña del tablero. Opcional en local; OBLIGATORIA en Vercel
# salvo que pongas ALLOW_PUBLIC=1.
DASHBOARD_PASSWORD=

# Poné 1 sólo si querés que cualquiera con el link vea el sprint del equipo.
# ALLOW_PUBLIC=1
